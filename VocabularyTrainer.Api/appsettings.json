{
  "Jwt": {
    "Issuer": "VocabularyTrainer",
    "Audience": "VocabularyTrainer.Clients",
    "AccessTokenLifetime": "00:15:00"
  },
  "Auth": {
    "RefreshTokenLifetime": "60.00:00:00",
    "VerificationCodeLifetime": "00:10:00",
    "VerificationCodeResendCooldown": "00:01:00",
    "VerificationCodesPerHour": 5,
    "VerificationCodeMaxAttempts": 5,
    "AuthRequestsPerMinutePerIp": 30
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 1025,
    "Security": "None",
    "FromAddress": "no-reply@vocabularytrainer.local",
    "FromName": "Vocabulary Trainer"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
